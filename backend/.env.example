# PaperPilot Secure Payment Backend Environment Variables
# Copy to backend/.env on your server (NEVER commit backend/.env or embed secrets inside the APK).

PORT=8080

# Firebase Admin / Firestore Configuration
FIREBASE_PROJECT_ID=gen-lang-client-0678944869
FIRESTORE_DATABASE_ID=ai-studio-android-paperpil-f88989c0-7c78-44d2-af9b-c52f2e63432a
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Authorized Administrator Emails (comma-separated, verified Google emails)
ADMIN_EMAILS=milanmoondal@gmail.com

# Razorpay Mode: ALWAYS start in 'test'. Switch to 'live' ONLY after merchant KYC verification & production webhook setup.
RAZORPAY_MODE=test

# Razorpay Credentials — enter your newly generated keys ONLY here on the backend server.
# NEVER put RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET in Android source code or BuildConfig.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret

# Optional: Razorpay Subscriptions Plan IDs for automatic recurring billing (/api/subscription/create)
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_YEARLY_PLAN_ID=

# Google Play Billing Verification (Android Publisher API)
GOOGLE_PLAY_PACKAGE_NAME=com.aistudio.paperpilot.xkqmvn
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Allowed CORS Origins (comma-separated, never wildcard '*' on authenticated endpoints)
ALLOWED_ORIGINS=https://paperpilot.app
